{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "2.9.0",
  "identifier": "com.nexus.ai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexus",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "center": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": true,
        "url": "/",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' http://127.0.0.1:17891 http://127.0.0.1:17892 https://*.supabase.co https://api.groq.com https://api.tavily.com https://api.perplexity.ai https://api.openai.com https://api.anthropic.com https://api.odcloud.kr https://opendart.fss.or.kr https://eutils.ncbi.nlm.nih.gov https://www.law.go.kr https://api.github.com https://*.googleapis.com https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'self' blob: https:; frame-src 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nexus"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQ0MxMDRFMDZGNUVBRjIKUldUeTZ2VUdUaERNVWhVUzBaa2IwWUJORjZ4UGJULytBWnp6ODZ2d09DZTNRVVIwWkxvenVpQkYK",
      "endpoints": [
        "https://github.com/sansarang/nexus-ai-releases/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "backend-bin/nexus-backend.exe": "nexus-backend.exe",
      "backend-bin/nexus-python.exe": "nexus-python.exe",
      "../backend/fonts/NanumGothic.ttf": "fonts/NanumGothic.ttf"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "entitlements": "../entitlements.plist",
      "infoPlist": null
    }
  }
}